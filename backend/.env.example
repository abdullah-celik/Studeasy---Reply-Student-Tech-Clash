# --- OpenAI ---
OPENAI_API_KEY=sk-...
# GPT-6 Luna: OpenAI's budget model (text + image input).
OPENAI_CHAT_MODEL=gpt-6-luna
# Leave empty: reasoning models may reject a temperature.
OPENAI_TEMPERATURE=
# Reasoning effort for tutor answers (none|low|medium|high). Empty for non-reasoning models.
OPENAI_REASONING_EFFORT=low
# Reasoning effort for quizzes, flashcards, reels, plans, grading. "none" = fastest/cheapest.
OPENAI_STRUCTURED_REASONING_EFFORT=none
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match vector(N) in supabase/schema.sql
EMBEDDING_DIMENSIONS=1536

# --- Supabase (Project settings -> API) ---
SUPABASE_URL=https://your-project.supabase.co
# Service role key: backend only, never ship it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- App ---
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
MAX_UPLOAD_MB=25
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=6
VERIFY_ANSWERS=true

# --- Reels (optional TikTok-style study feed) ---
ENABLE_REELS=true
REELS_PAGE_SIZE=6
REELS_BREAK_EVERY=15
REELS_SESSION_MINUTES=30
