# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Pick any current OpenAI chat model; this is only a default.
OPENAI_CHAT_MODEL=gpt-4o-mini
# Some reasoning models reject a temperature; leave empty to not send one.
OPENAI_TEMPERATURE=0.3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match vector(N) in supabase/schema.sql
EMBEDDING_DIMENSIONS=1536

# --- Supabase (Project settings -> API) ---
SUPABASE_URL=https://your-project.supabase.co
# Service role key: backend only, never ship it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- App ---
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
MAX_UPLOAD_MB=25
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=6
VERIFY_ANSWERS=true

# --- Reels (optional TikTok-style study feed) ---
ENABLE_REELS=true
REELS_PAGE_SIZE=6
REELS_BREAK_EVERY=15
REELS_SESSION_MINUTES=30
