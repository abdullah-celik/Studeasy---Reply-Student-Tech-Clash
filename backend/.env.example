# --- AI provider: "mistral" (free Experiment plan) or "openai" (paid) ---
# The embedding size must match vector(N) in supabase/schema.sql: Mistral 1024, OpenAI 1536.
LLM_PROVIDER=mistral

# --- Mistral (console.mistral.ai -> API Keys) ---
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_TEMPERATURE=0.3
# The free plan allows about 1 request per second per key.
MISTRAL_REQUESTS_PER_SECOND=0.9

# --- OpenAI (only used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
# GPT-6 Luna: OpenAI's budget model (text + image input).
OPENAI_CHAT_MODEL=gpt-6-luna
# Leave empty: reasoning models may reject a temperature.
OPENAI_TEMPERATURE=
# Reasoning effort for tutor answers (none|low|medium|high). Empty for non-reasoning models.
OPENAI_REASONING_EFFORT=low
# Reasoning effort for quizzes, flashcards, reels, plans, grading. "none" = fastest/cheapest.
OPENAI_STRUCTURED_REASONING_EFFORT=none
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Empty = the provider's size (Mistral 1024, OpenAI 1536)
EMBEDDING_DIMENSIONS=

# --- Supabase (Project settings -> API) ---
SUPABASE_URL=https://your-project.supabase.co
# Service role key: backend only, never ship it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- App ---
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
MAX_UPLOAD_MB=25
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=6
VERIFY_ANSWERS=true

# --- Reels (optional TikTok-style study feed) ---
ENABLE_REELS=true
REELS_PAGE_SIZE=6
REELS_BREAK_EVERY=15
REELS_SESSION_MINUTES=30
