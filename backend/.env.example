# --- AI provider: "cloudflare" (free daily allowance), "mistral" (paid plan) or "openai" (paid) ---
# The embedding size must match vector(N) in supabase/schema.sql: 1024 for Cloudflare and
# Mistral, 1536 for OpenAI.
LLM_PROVIDER=cloudflare

# --- Cloudflare Workers AI (dash.cloudflare.com -> AI -> Workers AI -> Use REST API) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3
CLOUDFLARE_TEMPERATURE=0.3

# Startup AI check, shown in /api/health
AI_SELF_TEST=true

# --- Mistral (only used when LLM_PROVIDER=mistral) ---
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_TEMPERATURE=0.3
MISTRAL_REQUESTS_PER_SECOND=0.9

# --- OpenAI (only used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
# GPT-6 Luna: OpenAI's budget model (text + image input).
OPENAI_CHAT_MODEL=gpt-6-luna
# Leave empty: reasoning models may reject a temperature.
OPENAI_TEMPERATURE=
# Reasoning effort for tutor answers (none|low|medium|high). Empty for non-reasoning models.
OPENAI_REASONING_EFFORT=low
# Reasoning effort for quizzes, flashcards, reels, plans, grading. "none" = fastest/cheapest.
OPENAI_STRUCTURED_REASONING_EFFORT=none
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Empty = the provider's size (Mistral 1024, OpenAI 1536)
EMBEDDING_DIMENSIONS=

# --- Supabase (Project settings -> API) ---
SUPABASE_URL=https://your-project.supabase.co
# Service role key: backend only, never ship it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- App ---
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
MAX_UPLOAD_MB=25
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=6
VERIFY_ANSWERS=true

# --- Reels (optional TikTok-style study feed) ---
ENABLE_REELS=true
REELS_PAGE_SIZE=6
REELS_BREAK_EVERY=15
REELS_SESSION_MINUTES=30
